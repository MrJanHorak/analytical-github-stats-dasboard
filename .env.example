# Fine-grained PAT: All repositories, Administration: Read-only, Metadata: Read-only
# (or a classic token with the `repo` scope)
GITHUB_TOKEN=

# Postgres connection string (e.g. Neon)
DATABASE_URL=

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: protects the dashboard with HTTP basic auth (any username)
DASHBOARD_PASSWORD=

# Optional DB tuning. Neon URLs (*.neon.tech) use the serverless HTTP driver automatically;
# any other Postgres URL (Railway, Supabase, local Docker) uses a normal TCP connection.
# DB_DRIVER=neon|pg
# DB_POOL_MAX=5

# Optional: ms the cron route may spend before deferring star/fork history backfills
# to the next run (default: maxDuration - 15s = 45000). Traffic is always collected first.
# SYNC_TIME_BUDGET_MS=45000
