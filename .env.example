# ── Required ─────────────────────────────────────────────────────────────────

# Fine-grained PAT: All repositories, Administration: Read-only, Contents: Read-only, Metadata: Read-only
# (or a classic token with the `repo` scope)
GITHUB_TOKEN=

# Postgres connection string (e.g. Neon)
DATABASE_URL=

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── Recommended ──────────────────────────────────────────────────────────────

# Protects the dashboard (and adding notes) with HTTP basic auth (any username).
# Set this on any public deployment.
DASHBOARD_PASSWORD=

# Public URL of this app — used for links in alert messages
# APP_URL=https://your-app.vercel.app

# ── Alerts (optional) ────────────────────────────────────────────────────────

# Slack or Discord incoming-webhook URL; new alerts are posted here after each sync
# ALERT_WEBHOOK_URL=
# ALERTS_ENABLED=true
# A day counts as a spike at ≥ this × the trailing daily average…
# ALERT_SPIKE_FACTOR=3
# …and at least this many views / clones that day
# ALERT_MIN_VIEWS=25
# ALERT_MIN_CLONES=10
# Stars gained in one day that count as a burst
# ALERT_STAR_BURST=5

# ── Badges (optional) ────────────────────────────────────────────────────────

# /api/badge/<owner>/<repo> serves public repos only; set to false to turn it off
# BADGES_ENABLED=true

# ── Tuning (optional) ────────────────────────────────────────────────────────

# Neon URLs (*.neon.tech) use the serverless HTTP driver automatically;
# any other Postgres URL (Railway, Supabase, local Docker) uses a normal TCP connection.
# DB_DRIVER=neon|pg
# DB_POOL_MAX=5

# ms the cron route may spend before deferring star/fork history backfills
# to the next run (default: maxDuration - 15s = 45000). Traffic is always collected first.
# SYNC_TIME_BUDGET_MS=45000
