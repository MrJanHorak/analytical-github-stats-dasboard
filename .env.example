# Fine-grained PAT: All repositories, Administration: Read-only, Metadata: Read-only
# (or a classic token with the `repo` scope)
GITHUB_TOKEN=

# Postgres connection string (e.g. Neon)
DATABASE_URL=

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: protects the dashboard with HTTP basic auth (any username)
DASHBOARD_PASSWORD=
